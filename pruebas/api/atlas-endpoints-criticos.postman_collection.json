{
  "info": {
    "name": "Atlas - endpoints críticos (EP1)",
    "description": "Colección de endpoints críticos de Atlas que pide la ERS (sección 3.1.2). Cada carpeta corresponde a un caso de prueba del informe. Las credenciales y la URL del ambiente QA van en el environment, no en la colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "CP-01 Inicio de sesión",
      "item": [
        {
          "name": "Login administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{adminUser}}\",\n  \"password\": \"{{adminPass}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// CP-01: login con credenciales validas",
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Tarda menos de 300 ms\", () => pm.expect(pm.response.responseTime).to.be.below(300));",
                  "pm.test(\"La URL usa HTTPS\", () => pm.expect(pm.request.url.protocol).to.eql(\"https\"));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"Entrega JWT y refresh token\", () => {",
                  "    pm.expect(body.token).to.be.a(\"string\");",
                  "    pm.expect(body.refreshToken).to.be.a(\"string\");",
                  "});",
                  "pm.test(\"No devuelve la contraseña ni el hash\", () => {",
                  "    const txt = pm.response.text();",
                  "    pm.expect(txt).to.not.include(\"password\");",
                  "    pm.expect(txt).to.not.include(\"$2b$\");",
                  "});",
                  "",
                  "// el payload del JWT viene en base64url, se decodifica para revisar la expiracion",
                  "const payload = JSON.parse(CryptoJS.enc.Base64.parse(",
                  "    body.token.split(\".\")[1].replace(/-/g, \"+\").replace(/_/g, \"/\")",
                  ").toString(CryptoJS.enc.Utf8));",
                  "pm.test(\"El JWT dura 15 minutos o menos\", () => pm.expect(payload.exp - payload.iat).to.be.at.most(900));",
                  "",
                  "pm.environment.set(\"tokenAdmin\", body.token);"
                ]
              }
            }
          ]
        }
      ]
    },
