    {
      "name": "CP-06 Inyección, XSS y CSRF",
      "item": [
        {
          "name": "SQLi en el login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"' OR '1'='1' --\",\n  \"password\": \"x\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"La inyección no da acceso\", () => pm.expect(pm.response.code).to.be.oneOf([400, 401, 422]));",
                  "pm.test(\"El error no muestra detalles de la base de datos\", () => {",
                  "    const txt = pm.response.text().toLowerCase();",
                  "    [\"syntax\", \"postgres\", \"sql\", \"stack\"].forEach(p => pm.expect(txt).to.not.include(p));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "SQLi en el filtro de clientes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/clientes?nombre=' OR '1'='1' --",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clientes"
              ],
              "query": [
                {
                  "key": "nombre",
                  "value": "' OR '1'='1' --"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"El filtro no se rompe con la carga\", () => pm.expect(pm.response.code).to.be.oneOf([200, 400]));",
                  "pm.test(\"No devuelve todos los clientes\", () => {",
                  "    if (pm.response.code === 200) pm.expect(pm.response.json().data || []).to.have.lengthOf(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "XSS en la descripción del cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/clientes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clientes"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"razonSocial\": \"Cliente XSS\",\n  \"rut\": \"76.123.456-0\",\n  \"descripcion\": \"<script>alert('xss')</script>\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Guarda o rechaza, pero nunca devuelve el script sin escapar\", () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 400, 422]);",
                  "    pm.expect(pm.response.text()).to.not.include(\"<script>\");",
                  "});",
                  "pm.test(\"Hay cabecera CSP\", () => pm.expect(pm.response.headers.has(\"Content-Security-Policy\")).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Modificación desde otro origen",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "https://sitio-externo.example"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/clientes/{{clienteId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clientes",
                "{{clienteId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telefono\": \"+56 9 0000 0000\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// se manda con un token valido pero desde otro origen y sin token CSRF",
                  "pm.test(\"Una petición desde otro origen se rechaza\", () => pm.expect(pm.response.code).to.be.oneOf([401, 403]));"
                ]
              }
            }
          ]
        }
      ]
    }
